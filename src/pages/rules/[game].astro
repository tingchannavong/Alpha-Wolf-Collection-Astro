---
import MainLayout from "../../layouts/main-layout.astro";
import ManualCard from "../../components/manual-card.astro";

export async function getStaticPaths() {
    const allGames = await Astro.glob(`../boardgames/*.md`);
    const pathsArray = allGames.map( game => {
        const name = game.url.split('/').pop();

        return {
            params: { game: name }
        }
    })
    return pathsArray;
}

const { game } = Astro.params;
const gamesList = await Astro.glob(`../boardgames/*.md`);

const currentGame = gamesList.find( each => {
    const filename = each.url.split('/').pop();
    return filename === game;
});

const manuals = currentGame?.frontmatter?.manuals || [];
---
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/alpha_style.css">
    <title>Instruction</title>
</head>

<MainLayout>
    <body>
        <section id="all-games-section" class="container">
            <button>Back</button>
            <button>Read More</button>
            <div class="container">
                <div class="carousel-wrapper">
                <div class="gallery">
                    {
                    manuals.map( img_url =>  <ManualCard image={img_url}></ManualCard>)
                    }
                </div>    
                </div> 
                <nav class="lil-nav"></nav>
            </div>
        </section>
    </body>
</MainLayout>