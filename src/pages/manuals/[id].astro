
---
import MainLayout from "../../layouts/main-layout.astro";
import ManualCard from "../../components/manual-card.astro";

export function getStaticPaths() {
    return [
        { params: { id: 'one' } },
        { params: { id: 'two' } },
         { params: { id: 'cockroach_poker' } },
    ];
}

const { id } = Astro.params;
const allGames = await Astro.glob(`../boardgames/*.md`);

const currentGame = allGames.find( game => {
    const filename = game.url.split('/').pop();
    return filename.trim() === id.trim();
});

const manuals = currentGame?.frontmatter?.manuals || [];

